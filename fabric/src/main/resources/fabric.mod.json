{
  "schemaVersion": 1,
  "id": "betterarcheology",
  "version": "${version}",
  "name": "${displayName}",
  "description": "${modDescription}",
  "authors": [
    "${authors}"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/better-archeology",
    "sources": "https://github.com/Pandarix/BetterArcheology-MultiLoaded",
    "issues": "https://github.com/Pandarix/BetterArcheology-MultiLoaded/issues"
  },
  "license": "MIT",
  "icon": "assets/betterarcheology/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.Pandarix.fabric.BAFabric"
    ],
    "client": [
      "net.Pandarix.fabric.client.BAFabricClient"
    ],
    "fabric-datagen": [
      "net.Pandarix.fabric.datagen.ModDataGenerators"
    ],
    "rei_common": ["net.Pandarix.compat.rei.ReiPlugin"],
    "rei_client": ["net.Pandarix.compat.rei.ReiClientPlugin"],
    "jei_mod_plugin": ["net.Pandarix.compat.jei.JeiPlugin"]
  },
  "mixins": [
    "betterarcheology.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": ">=26.1",
    "java": ">=25",
    "architectury": ">=20.0.0",
    "resourcefulconfig": ">=3.9.0",
    "fabric-api": "*"
  }
}
